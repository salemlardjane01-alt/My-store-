rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Role-Based dynamic lookup from the users collection
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'support');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && 
                    (!request.resource.data.keys().hasAny(['role']) ||
                     request.resource.data.role == 'customer' ||
                     (request.resource.data.role == 'owner' && 
                      (!exists(/databases/$(database)/documents/settings/metadata) ||
                       !get(/databases/$(database)/documents/settings/metadata).data.keys().hasAny(['ownerUid']) ||
                       get(/databases/$(database)/documents/settings/metadata).data.ownerUid == request.auth.uid)));
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if true; // Allow client/guest checkouts to register orders
      allow update, delete: if isAdmin();
    }

    // Analytics Collection
    match /analytics/{analyticsId} {
      allow read: if isAdmin();
      allow create, update: if true; // Let client-side guest checkouts update pre-aggregated statistics during order creation transaction
    }

    // Settings Collection (Hero configuration settings)
    match /settings/{settingId} {
      allow read: if true; // Publicly readable for all customers to download layout styles
      allow write: if isAdmin() || (
        settingId == 'metadata' && 
        isSignedIn() && (
          // If metadata does not exist, we can write it and claim ownerUid
          (!exists(/databases/$(database)/documents/settings/metadata) && 
           request.resource.data.ownerUid == request.auth.uid) ||
          // If it exists but has no ownerUid, we can add ours
          (!get(/databases/$(database)/documents/settings/metadata).data.keys().hasAny(['ownerUid']) && 
           request.resource.data.ownerUid == request.auth.uid)
        )
      );
      
      // Let any checkout process increment the order counter safely
      allow create: if settingId == 'counters'
        && request.resource.data.keys().hasAll(['lastOrderNumber'])
        && request.resource.data.keys().size() == 1
        && request.resource.data.lastOrderNumber is number
        && request.resource.data.lastOrderNumber == 1001;
        
      allow update: if settingId == 'counters'
        && request.resource.data.lastOrderNumber is number
        && request.resource.data.lastOrderNumber > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastOrderNumber']);
    }

    // Shipping Rates Collection
    match /shipping_rates/{wilayaId} {
      allow read: if true; // Publicly readable to query rates during checkout
      allow write: if isAdmin(); // Only Admin can update shipping rates
    }
  }
}
