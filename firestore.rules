rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'salemlardjane01@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && resource.data.stock is number
        && request.resource.data.stock <= resource.data.stock
      );
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if true; // Allow client/guest checkouts to register orders
      allow update, delete: if isAdmin();
    }

    // Analytics Collection
    match /analytics/{analyticsId} {
      allow get: if isAdmin() || analyticsId == 'dashboard';
      allow list: if isAdmin();
      allow create, update: if analyticsId == 'dashboard'
        && request.resource.data.keys().hasOnly(['initialized', 'globalStats', 'dailyStats', 'logs']);
    }

    // Settings Collection (Hero, Social, Delivery, Counters, Telegram)
    match /settings/{settingId} {
      allow read: if true; // Publicly readable for storefront config and checkout
      allow write: if isAdmin(); // Only Admin can write or alter settings
      
      // Let any checkout process increment the order counter safely
      allow create: if settingId == 'counters'
        && request.resource.data.keys().hasAll(['lastOrderNumber'])
        && request.resource.data.keys().size() == 1
        && request.resource.data.lastOrderNumber is number
        && request.resource.data.lastOrderNumber == 1001;
        
      allow update: if settingId == 'counters'
        && request.resource.data.lastOrderNumber is number
        && request.resource.data.lastOrderNumber > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastOrderNumber']);

      // Let checkout advance the Telegram round-robin bot index safely
      allow update: if settingId == 'telegram'
        && request.resource.data.lastUsedBotIndex is number
        && request.resource.data.lastUsedBotIndex >= 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastUsedBotIndex']);
    }

    // Shipping Rates Collection
    match /shipping_rates/{wilayaId} {
      allow read: if true; // Publicly readable to query rates during checkout
      allow write: if isAdmin(); // Only Admin can update shipping rates
    }

    // Colors Collection (Global color presets)
    match /colors/{colorId} {
      allow read: if true; // Publicly readable for products and options display
      allow write: if isAdmin(); // Only Admin can add, update or delete color presets
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if false;
    }
  }
}
